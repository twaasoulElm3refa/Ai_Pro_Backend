APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

AIARABIC_INTERNAL_API_KEY=test123
AIARABIC_INJECT_QDRANT_CONTEXT=false
AI_CONVERSATION_TOKEN_LIMIT=7000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# PayPal Checkout / wallet deposits. Never commit real credentials.
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_VERIFY_WEBHOOK=true
PAYPAL_MERCHANT_ID=
PAYPAL_RECONCILIATION_AGE_MINUTES=10
WALLET_POINTS_PER_USD=1000000

MOYASAR_MODE=test
MOYASAR_API_URL=https://api.moyasar.com/v1
MOYASAR_TEST_PUBLISHABLE_KEY=
MOYASAR_TEST_SECRET_KEY=
MOYASAR_LIVE_PUBLISHABLE_KEY=
MOYASAR_LIVE_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
MOYASAR_CURRENCY=SAR
MOYASAR_MERCHANT_ID=
MOYASAR_MERCHANT_NAME="AI Pro"
MOYASAR_POINTS_PER_SAR=1000000
MOYASAR_INVOICE_EXPIRY_MINUTES=30
MOYASAR_RECONCILIATION_AGE_MINUTES=10
MOYASAR_RECONCILIATION_MAX_AGE_HOURS=72
MOYASAR_TIMEOUT=20
MOYASAR_CONNECT_TIMEOUT=5
MOYASAR_GET_RETRIES=2

# Frontend values are public after build; VITE_API_KEY is not a secret boundary.
VITE_API_BASE_URL=/api/v1
VITE_API_ROOT_URL=/api
VITE_API_KEY=
VITE_INTERNAL_API_KEY=
VITE_WALLET_POLL_INTERVAL_MS=5000
VITE_WALLET_POLL_TIMEOUT_MS=150000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
